# Copy to .env.local for local development.
# Never commit real credentials. Use PayPal Sandbox credentials only.

PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Vercel AI Gateway. Keep keys server-side; never use NEXT_PUBLIC_* for secrets.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
# Optional override for a compatible endpoint:
# AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions

# Optional application URL for local/deployed callbacks.
APP_URL=http://localhost:3000

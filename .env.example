# Copy to .env.local for local development.
# Never commit real credentials. Use PayPal Sandbox credentials only.

PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Supabase order storage (server-side only).
# Never use NEXT_PUBLIC_ for this service key and never commit its real value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_side_service_role_key

# Groq AI: used for structured order intake and evidence explanations.
# Create a key at https://console.groq.com/ and keep it server-side.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Optional application URL for PayPal return/cancel callbacks.
APP_URL=http://localhost:3000

# Copy to .env.local for local development.
# Never commit real credentials. Use PayPal Sandbox credentials only.

PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Configure the AI provider selected during implementation.
# Keep the key server-side; never expose it through NEXT_PUBLIC_* variables.
AI_PROVIDER=replace_me
AI_API_KEY=your_ai_provider_key
AI_MODEL=replace_me

# Optional application URL for local/deployed callbacks.
APP_URL=http://localhost:3000
